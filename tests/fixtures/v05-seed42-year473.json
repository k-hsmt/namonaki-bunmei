{"version":2,"seed":42,"rngState":2831568080,"year":473,"name":"ミルハの民","homeland":"季節風の吹く丘陵","trait":"高原の放牧","population":73660,"food":100,"cohesion":44.329999999998506,"knowledge":85.69999999999997,"exchange":63.8,"culture":100,"drought":0,"epidemic":0,"lastKind":{"pottery":289,"well":440,"midwife":469,"famine":373,"isolation":471,"abandon":319,"song":328,"fish":472,"language":202,"craft":366,"drought":458,"navigation":75,"bridge_repair":362,"flood":84,"irrigation":201,"migration":427,"pilgrim":351,"rebirth":105,"artisan":339,"decline":112,"ritual":461,"garden":121,"trade":451,"peace":142,"harvest":206,"earthquake":149,"storyteller":306,"apprentice":227,"landslide":162,"arrival":342,"fishing_ban":169,"new_crops":288,"marriage":204,"tax":444,"council":226,"disease":353,"salt":258,"first_granary":261,"fire":375,"storm":265,"first_archive":301,"healing":304,"market":334,"dispute":365,"first_port":419,"writing":436,"first_library":462},"history":[{"id":"0-0","year":0,"tag":"誕生","title":"ミルハの民が生まれる","body":"季節風の吹く丘陵に、いくつかの集落が形成された。人々は高原の放牧を暮らしの中心とし、まだ自分たちの行く末を知らない。","causes":["地形と生活様式が抽選された"],"important":true},{"id":"7-1","year":7,"tag":"知恵","title":"器を焼く窯が改良される","body":"長く火を保つ方法が伝わり、丈夫な器が日常に増えた。","causes":["ものづくりの蓄積"],"important":false},{"id":"14-2","year":14,"tag":"暮らし","title":"共同井戸が掘られる","body":"水を汲むための場所ができ、朝には自然と人が集まるようになった。","causes":["水の確保"],"important":false},{"id":"14-3","year":14,"tag":"継承","title":"水路と堤の管理が根づく","body":"共同井戸が掘られる。この経験が後の世代へ受け継がれた。","causes":["長く続く暮らしの変化"],"important":true},{"id":"19-4","year":19,"tag":"暮らし","title":"出産を助ける経験が語り継がれる","body":"年長者の経験が家々へ伝わり、家族のあり方にも小さな変化が生まれた。","causes":["世代間の知識の伝承"],"important":false},{"id":"19-5","year":19,"tag":"継承","title":"看病と衛生の知恵が根づく","body":"出産を助ける経験が語り継がれる。この経験が後の世代へ受け継がれた。","causes":["長く続く暮らしの変化"],"important":true},{"id":"27-6","year":27,"tag":"危機","title":"飢えの季節が訪れる","body":"食糧が足りず、幼い者や年長者から命を落とす人が出た。別の土地を目指す家族もいる。","causes":["食糧備蓄の不足","社会の脆弱性"],"important":true},{"id":"31-7","year":31,"tag":"交流","title":"古い交易路が途絶える","body":"遠くから届いていた品が来なくなった。集落は身近な資源を頼るようになった。","causes":["交通や相手社会の変化"],"important":false},{"id":"34-8","year":34,"tag":"人々","title":"遠い村で灯りが消える","body":"かつて人の住んだ場所が使われなくなり、草が道を覆った。","causes":["地域ごとの人口移動"],"important":false},{"id":"46-9","year":46,"tag":"文化","title":"川辺の歌が幾世代も歌い継がれる","body":"ある歌は広く知られるようになり、歌詞を変えながら遠くの村へ伝わった。","causes":["口承文化の変化"],"important":false},{"id":"49-10","year":49,"tag":"暮らし","title":"川の漁に新しい網が使われる","body":"編み方を変えた網が広まり、浅瀬での漁の仕方が変わった。","causes":["生計の工夫"],"important":false},{"id":"55-11","year":55,"tag":"文化","title":"新しい言い回しが広がる","body":"季節の祭りで歌われた言葉が、離れた集落にも伝わった。少しずつ共通の言葉が育ってゆく。","causes":["集落間の交流","世代を越えた伝承"],"important":false},{"id":"62-12","year":62,"tag":"知恵","title":"道具づくりに新しい工夫が生まれる","body":"木や石を扱う手順が少し変わり、仕事に必要な時間が減った。すべての集落に伝わるには時間がかかる。","causes":["反復作業からの学習"],"important":false},{"id":"73-13","year":73,"tag":"暮らし","title":"共同井戸が掘られる","body":"水を汲むための場所ができ、朝には自然と人が集まるようになった。","causes":["水の確保"],"important":false},{"id":"74-14","year":74,"tag":"自然","title":"雨を待つ季節が続く","body":"井戸は浅くなり、共同の貯蔵庫が開かれた。畑と家畜のどちらを優先するかで意見が分かれる。","causes":["連続した少雨","貯蔵食糧への依存"],"important":false},{"id":"75-15","year":75,"tag":"知恵","title":"遠い岬を越える航海が試みられる","body":"風を読む経験が積み重なり、沿岸の移動は少しずつ遠くまで届くようになった。","causes":["海岸生活","移動技術の伝承"],"important":false},{"id":"77-16","year":77,"tag":"暮らし","title":"古い橋が修繕される","body":"傷んだ橋板を取り換えた。旅をする人も、近くに暮らす人も、その小さな仕事に助けられた。","causes":["交通の維持"],"important":false},{"id":"84-17","year":84,"tag":"自然","title":"大河が堤を越える","body":"数日続いた雨で低地が水に浸かった。失われた畑がある一方、水が引いた土地には新しい土が残った。","causes":["河川に近い居住地","大雨による浸水"],"important":false},{"id":"85-18","year":85,"tag":"知恵","title":"水を分けるための溝が掘られる","body":"いくつかの集落が協力し、畑へ水を引く仕組みを作った。維持のための取り決めも生まれた。","causes":["河川へのアクセス","共同労働"],"important":false},{"id":"95-19","year":95,"tag":"知恵","title":"器を焼く窯が改良される","body":"長く火を保つ方法が伝わり、丈夫な器が日常に増えた。","causes":["ものづくりの蓄積"],"important":false},{"id":"97-20","year":97,"tag":"人々","title":"一部の家族が新天地へ旅立つ","body":"土地の負担と新しい暮らしへの期待から、幾つかの家族が遠くへ移った。彼らの消息はときおり届く。","causes":["土地への人口圧力","移住という選択"],"important":false},{"id":"101-21","year":101,"tag":"文化","title":"遠くの祈りの場所へ向かう人が現れる","body":"人々は旅の途中で歌や物語を交換した。","causes":["文化的な往来"],"important":false},{"id":"105-22","year":105,"tag":"人々","title":"忘れられた土地に人が戻る","body":"離れていた家族の子孫が再び暮らし始めた。古い石積みは、新しい家の一部となった。","causes":["利用可能な土地","生計の回復"],"important":false},{"id":"108-23","year":108,"tag":"暮らし","title":"布の染め方が変わる","body":"新しい色の布が祭りに現れ、やがて普段着にも使われた。","causes":["工芸と習慣の変化"],"important":false},{"id":"112-24","year":112,"tag":"人々","title":"人の住まなくなった村が現れる","body":"かつての道は草に覆われた。人々が去った理由は一つではなかった。","causes":["生活基盤の変化","移住の蓄積"],"important":false},{"id":"114-25","year":114,"tag":"文化","title":"祖先を偲ぶ祭りが始まる","body":"死者の名を語る集まりが、年に一度の習わしになった。誰が始めたのかは、やがて忘れられた。","causes":["社会的記憶","儀礼の共有"],"important":false},{"id":"121-26","year":121,"tag":"暮らし","title":"家々で小さな菜園が広まる","body":"家の近くで育てる作物が増え、食卓に季節ごとの変化が生まれた。","causes":["日々の試行錯誤"],"important":false},{"id":"125-27","year":125,"tag":"交流","title":"物々交換の道が伸びる","body":"山向こうの集落と品物が行き交い、ここにはない素材や食べ物が手に入るようになった。","causes":["人の移動","余剰生産物の交換"],"important":false},{"id":"125-28","year":125,"tag":"継承","title":"継続した交易網が根づく","body":"物々交換の道が伸びる。この経験が後の世代へ受け継がれた。","causes":["長く続く暮らしの変化"],"important":true},{"id":"142-29","year":142,"tag":"暮らし","title":"特筆すべき争いのない時代が続く","body":"子が大人となり、親の仕事を受け継いだ。歴史書にはわずかしか記されない、長い日常があった。","causes":["比較的安定した社会環境"],"important":false},{"id":"144-30","year":144,"tag":"暮らし","title":"思いがけず豊作の年となる","body":"季節の巡りが穏やかで、蓄えを増やすことができた。人々の暮らしに短い余裕が訪れた。","causes":["降雨が比較的安定","食糧生産の年変動"],"important":false},{"id":"149-31","year":149,"tag":"自然","title":"大地が揺れ、集落の一部が崩れる","body":"揺れは短かったが、家屋と水路に被害を残した。人々は住む場所の安全を考え直し始めた。","causes":["地殻活動（簡略化した確率モデル）"],"important":false},{"id":"152-32","year":152,"tag":"危機","title":"飢えの季節が訪れる","body":"食糧が足りず、幼い者や年長者から命を落とす人が出た。別の土地を目指す家族もいる。","causes":["食糧備蓄の不足","社会の脆弱性"],"important":true},{"id":"153-33","year":153,"tag":"文化","title":"旅する語り部が集落を訪れる","body":"遠くの話と土地の昔話が混じり、誰も由来を知らない物語が生まれた。","causes":["口承文化の交流"],"important":false},{"id":"158-34","year":158,"tag":"暮らし","title":"古い橋が修繕される","body":"傷んだ橋板を取り換えた。旅をする人も、近くに暮らす人も、その小さな仕事に助けられた。","causes":["交通の維持"],"important":false},{"id":"160-35","year":160,"tag":"知恵","title":"職人たちが弟子を集める","body":"道具の扱い方を教える場ができ、技術が一族の外へ伝わった。","causes":["技能の継承"],"important":false},{"id":"162-36","year":162,"tag":"自然","title":"丘の斜面が崩れる","body":"夜半に土砂が流れ、小道がふさがれた。人々は迂回路を探した。","causes":["斜面の不安定化"],"important":false},{"id":"164-37","year":164,"tag":"人々","title":"遠方から旅人が訪れる","body":"異なる言葉と習慣を持つ一団が定住を望んだ。最初は距離があったが、次第に仕事を分かち合った。","causes":["移住ネットワーク","社会的接触"],"important":false},{"id":"164-38","year":164,"tag":"継承","title":"移住者との共生が根づく","body":"遠方から旅人が訪れる。この経験が後の世代へ受け継がれた。","causes":["長く続く暮らしの変化"],"important":true},{"id":"169-39","year":169,"tag":"社会","title":"川の一部で漁を休む決まりができる","body":"魚が減ったとの声を受け、季節ごとの禁漁が試された。","causes":["資源利用の調整"],"important":false},{"id":"173-40","year":173,"tag":"自然","title":"雨を待つ季節が続く","body":"井戸は浅くなり、共同の貯蔵庫が開かれた。畑と家畜のどちらを優先するかで意見が分かれる。","causes":["連続した少雨","貯蔵食糧への依存"],"important":false},{"id":"180-41","year":180,"tag":"暮らし","title":"共同井戸が掘られる","body":"水を汲むための場所ができ、朝には自然と人が集まるようになった。","causes":["水の確保"],"important":false},{"id":"190-42","year":190,"tag":"暮らし","title":"遠来の種が畑に根づく","body":"持ち込まれた種は最初こそ珍しがられたが、やがて土地の食卓になじんだ。","causes":["人と作物の移動"],"important":false},{"id":"201-43","year":201,"tag":"知恵","title":"水を分けるための溝が掘られる","body":"いくつかの集落が協力し、畑へ水を引く仕組みを作った。維持のための取り決めも生まれた。","causes":["河川へのアクセス","共同労働"],"important":false},{"id":"202-44","year":202,"tag":"文化","title":"新しい言い回しが広がる","body":"季節の祭りで歌われた言葉が、離れた集落にも伝わった。少しずつ共通の言葉が育ってゆく。","causes":["集落間の交流","世代を越えた伝承"],"important":false},{"id":"203-45","year":203,"tag":"交流","title":"古い交易路が途絶える","body":"遠くから届いていた品が来なくなった。集落は身近な資源を頼るようになった。","causes":["交通や相手社会の変化"],"important":false},{"id":"204-46","year":204,"tag":"人々","title":"離れた集落同士の婚姻が増える","body":"親族のつながりが広がり、境界の意味が少しずつ変わった。","causes":["社会関係の拡大"],"important":false},{"id":"205-47","year":205,"tag":"継承","title":"継続した交易網が失われる","body":"かつて受け継がれていた習慣や施設は、いまでは見られなくなった。","causes":["維持する条件の変化"],"important":true},{"id":"206-48","year":206,"tag":"暮らし","title":"思いがけず豊作の年となる","body":"季節の巡りが穏やかで、蓄えを増やすことができた。人々の暮らしに短い余裕が訪れた。","causes":["降雨が比較的安定","食糧生産の年変動"],"important":false},{"id":"209-49","year":209,"tag":"制度","title":"共同作業の分担が記される","body":"誰が何日働いたかを記す決まりが生まれ、負担の公平さが話し合われた。","causes":["共同事業の複雑化"],"important":false},{"id":"209-50","year":209,"tag":"継承","title":"寄り合いの制度が根づく","body":"共同作業の分担が記される。この経験が後の世代へ受け継がれた。","causes":["長く続く暮らしの変化"],"important":true},{"id":"223-51","year":223,"tag":"選択","title":"遠くの村へ贈る","body":"舟に食糧が積まれ、遠くへ運ばれた。","causes":["偶然に委ねられた選択"],"important":true},{"id":"223-52","year":223,"tag":"継承","title":"継続した交易網が根づく","body":"遠方への往来が次世代まで続いた。","causes":["長く続く暮らしの変化"],"important":true},{"id":"226-53","year":226,"tag":"社会","title":"集落を越えた話し合いが始まる","body":"用水と境界をめぐる争いを収めるため、人々は定期的に集まるようになった。","causes":["共同資源の管理"],"important":false},{"id":"227-54","year":227,"tag":"知恵","title":"職人たちが弟子を集める","body":"道具の扱い方を教える場ができ、技術が一族の外へ伝わった。","causes":["技能の継承"],"important":false},{"id":"229-55","year":229,"tag":"自然","title":"雨を待つ季節が続く","body":"井戸は浅くなり、共同の貯蔵庫が開かれた。畑と家畜のどちらを優先するかで意見が分かれる。","causes":["連続した少雨","貯蔵食糧への依存"],"important":false},{"id":"231-56","year":231,"tag":"疫病","title":"熱病が集落を巡る","body":"発熱を伴う病が広がった。看病と葬送が日常を変え、人々の往来もしばらく減った。","causes":["人口集中による接触機会","交流路を介した伝播の可能性"],"important":true},{"id":"242-57","year":242,"tag":"継承","title":"看病と衛生の知恵が失われる","body":"かつて受け継がれていた習慣や施設は、いまでは見られなくなった。","causes":["維持する条件の変化"],"important":true},{"id":"247-58","year":247,"tag":"文化","title":"川辺の歌が幾世代も歌い継がれる","body":"ある歌は広く知られるようになり、歌詞を変えながら遠くの村へ伝わった。","causes":["口承文化の変化"],"important":false},{"id":"258-59","year":258,"tag":"交流","title":"塩を運ぶ道が定まる","body":"遠くの土地から塩が運ばれ、保存食の作り方が変わった。","causes":["交易路の形成"],"important":false},{"id":"261-60","year":261,"tag":"制度","title":"共同の穀物庫が築かれる","body":"豊かな季節の余剰を集め、飢えた家へ分ける場所が生まれた。管理をめぐる新しい役目も生まれる。","causes":["余剰生産","食糧の共同管理"],"important":false},{"id":"261-61","year":261,"tag":"継承","title":"共同の穀物庫が根づく","body":"共同の穀物庫が築かれる。この経験が後の世代へ受け継がれた。","causes":["長く続く暮らしの変化"],"important":true},{"id":"262-62","year":262,"tag":"災厄","title":"大きな火災が住まいを焼く","body":"乾いた季節の火が集落へ燃え移った。再建を通して住居の造りを改める人々もいた。","causes":["可燃物の蓄積","乾燥した気候"],"important":false},{"id":"265-63","year":265,"tag":"自然","title":"激しい嵐が季節を乱す","body":"風雨によって食糧の蓄えと住まいの一部が失われた。再建は少しずつ進む。","causes":["季節的な気象の変動"],"important":false},{"id":"267-64","year":267,"tag":"暮らし","title":"布の染め方が変わる","body":"新しい色の布が祭りに現れ、やがて普段着にも使われた。","causes":["工芸と習慣の変化"],"important":false},{"id":"281-65","year":281,"tag":"暮らし","title":"共同井戸が掘られる","body":"水を汲むための場所ができ、朝には自然と人が集まるようになった。","causes":["水の確保"],"important":false},{"id":"288-66","year":288,"tag":"暮らし","title":"遠来の種が畑に根づく","body":"持ち込まれた種は最初こそ珍しがられたが、やがて土地の食卓になじんだ。","causes":["人と作物の移動"],"important":false},{"id":"289-67","year":289,"tag":"知恵","title":"器を焼く窯が改良される","body":"長く火を保つ方法が伝わり、丈夫な器が日常に増えた。","causes":["ものづくりの蓄積"],"important":false},{"id":"301-68","year":301,"tag":"文化","title":"記録を守る人々が現れる","body":"季節の巡りや過去の飢饉を書き残す習わしが生まれた。記録は争いにも和解にも使われた。","causes":["知識の蓄積","共同体の記憶"],"important":false},{"id":"301-69","year":301,"tag":"継承","title":"記録の習慣が根づく","body":"記録を守る人々が現れる。この経験が後の世代へ受け継がれた。","causes":["長く続く暮らしの変化"],"important":true},{"id":"304-70","year":304,"tag":"暮らし","title":"病を見守る習わしが広まる","body":"経験を語り継ぐ者が増え、病人を隔てて世話する工夫が生まれた。効果はまだ確かなものではない。","causes":["過去の流行の記憶"],"important":false},{"id":"304-71","year":304,"tag":"継承","title":"看病と衛生の知恵が根づく","body":"病を見守る習わしが広まる。この経験が後の世代へ受け継がれた。","causes":["長く続く暮らしの変化"],"important":true},{"id":"306-72","year":306,"tag":"継承","title":"継続した交易網が失われる","body":"かつて受け継がれていた習慣や施設は、いまでは見られなくなった。","causes":["維持する条件の変化"],"important":true},{"id":"306-73","year":306,"tag":"文化","title":"旅する語り部が集落を訪れる","body":"遠くの話と土地の昔話が混じり、誰も由来を知らない物語が生まれた。","causes":["口承文化の交流"],"important":false},{"id":"318-74","year":318,"tag":"災厄","title":"大きな火災が住まいを焼く","body":"乾いた季節の火が集落へ燃え移った。再建を通して住居の造りを改める人々もいた。","causes":["可燃物の蓄積","乾燥した気候"],"important":false},{"id":"319-75","year":319,"tag":"人々","title":"遠い村で灯りが消える","body":"かつて人の住んだ場所が使われなくなり、草が道を覆った。","causes":["地域ごとの人口移動"],"important":false},{"id":"328-76","year":328,"tag":"文化","title":"川辺の歌が幾世代も歌い継がれる","body":"ある歌は広く知られるようになり、歌詞を変えながら遠くの村へ伝わった。","causes":["口承文化の変化"],"important":false},{"id":"334-77","year":334,"tag":"交流","title":"定期的な市が立つ","body":"月に幾度か、離れた集落の人々が品物と噂話を持ち寄るようになった。","causes":["人口集中","交換の反復"],"important":false},{"id":"339-78","year":339,"tag":"暮らし","title":"布の染め方が変わる","body":"新しい色の布が祭りに現れ、やがて普段着にも使われた。","causes":["工芸と習慣の変化"],"important":false},{"id":"342-79","year":342,"tag":"人々","title":"遠方から旅人が訪れる","body":"異なる言葉と習慣を持つ一団が定住を望んだ。最初は距離があったが、次第に仕事を分かち合った。","causes":["移住ネットワーク","社会的接触"],"important":false},{"id":"346-80","year":346,"tag":"人々","title":"一部の家族が新天地へ旅立つ","body":"土地の負担と新しい暮らしへの期待から、幾つかの家族が遠くへ移った。彼らの消息はときおり届く。","causes":["土地への人口圧力","移住という選択"],"important":false},{"id":"351-81","year":351,"tag":"文化","title":"遠くの祈りの場所へ向かう人が現れる","body":"人々は旅の途中で歌や物語を交換した。","causes":["文化的な往来"],"important":false},{"id":"353-82","year":353,"tag":"疫病","title":"熱病が集落を巡る","body":"発熱を伴う病が広がった。看病と葬送が日常を変え、人々の往来もしばらく減った。","causes":["人口集中による接触機会","交流路を介した伝播の可能性"],"important":true},{"id":"362-83","year":362,"tag":"暮らし","title":"古い橋が修繕される","body":"傷んだ橋板を取り換えた。旅をする人も、近くに暮らす人も、その小さな仕事に助けられた。","causes":["交通の維持"],"important":false},{"id":"365-84","year":365,"tag":"社会","title":"土地の使い方をめぐって対立する","body":"新しい畑を求める家族と古い習慣を守る家族の間で、長い話し合いが続いた。","causes":["人口と土地への需要","意思決定の摩擦"],"important":false},{"id":"366-85","year":366,"tag":"知恵","title":"道具づくりに新しい工夫が生まれる","body":"木や石を扱う手順が少し変わり、仕事に必要な時間が減った。すべての集落に伝わるには時間がかかる。","causes":["反復作業からの学習"],"important":false},{"id":"373-86","year":373,"tag":"危機","title":"飢えの季節が訪れる","body":"食糧が足りず、幼い者や年長者から命を落とす人が出た。別の土地を目指す家族もいる。","causes":["食糧備蓄の不足","社会の脆弱性"],"important":true},{"id":"375-87","year":375,"tag":"災厄","title":"大きな火災が住まいを焼く","body":"乾いた季節の火が集落へ燃え移った。再建を通して住居の造りを改める人々もいた。","causes":["可燃物の蓄積","乾燥した気候"],"important":false},{"id":"419-88","year":419,"tag":"交流","title":"川辺に常設の交易所ができる","body"